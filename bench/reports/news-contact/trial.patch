+"""At most two supplementary same-domain feed/sitemap requests, candidates never events."""
+import html
+import calendar
+import re
+from datetime import datetime, timezone, timedelta
+from urllib.parse import urljoin, urlsplit
+import xml.etree.ElementTree as ET
+
+from ..budget import SourceFailure
+from ..models.evidence import digest
+from ..sources.extract import Section, add, response_source
+from ..workers import offload
+from .activity import parse
+from .fetcher import extra_request_ceiling
+from .html import Page
+from .policy import domain, normalize_url
+from .social import path_scope, company_names, mentions_company
+
+
+def entries(body, url, now):
+    items, children = parse(body, url, now)
+    cutoff=now.date().replace(year=now.year-2, day=min(now.day,calendar.monthrange(now.year-2,now.month)[1]))
+    return [(value, locator, span) for value, locator, span in items
+            if value['date'] and cutoff <=
+            datetime.fromisoformat(value['date']).date() <= now.date()
+            and not re.search(r'/(?:produkt[^/]*|products?|shop|kategori|category|tags?|archive|side|page)(?:/|$)',
+                              urlsplit(value['url']).path, re.I)], children
+
+
+def nominations(proof, pages, robots):
+    root = domain(proof.value['final_url']);feeds=[];maps=[]
+    for response, page in pages:
+        if domain(response.url) != root:continue
+        for tag in re.findall(r'<link\b[^>]*>', page.raw, re.I):
+            attrs={k.lower():html.unescape(v) for k,_,v in re.findall(r'([\w-]+)\s*=\s*([\'"])(.*?)\2', tag, re.S)}
+            if attrs.get('type','').lower() in {'application/rss+xml','application/atom+xml'} and 'alternate' in attrs.get('rel','').lower():
+                target=normalize_url(urljoin(response.url, attrs.get('href','')))
+                if target and domain(target)==root:feeds.append(target)
+    for origin, parser in sorted(robots.items()):
+        if domain(origin)==root:maps.extend(u for u in parser.site_maps() or [] if domain(u)==root)
+    base=proof.value['final_url'].split('?',1)[0].rstrip('/')
+    return list(dict.fromkeys(sorted(set(feeds))+sorted(set(maps))+[base+'/sitemap.xml',base+'/sitemap_index.xml']))
+
+
+async def supplement(section, org, envelope, http, pages):
+    if any(c.field.startswith('dated_item.') and c.availability=='available' for c in section.claims):
+        return section  # Existing verified article discovery already succeeded.
+    proof=next((c for c in envelope.claims if c.field=='official_website' and c.availability=='available'),None)
+    if not proof or proof.carried_forward or proof.value.get('identity_level')!='VERIFIED' or proof.value.get('content_allowed') is False:
+        return section
+    context={'name':next((c.value for c in envelope.claims if c.field=='identity.legal_name' and c.availability=='available'),''),
+             'subunits':[c.value for c in envelope.claims if c.field.startswith('subunits.unit.') and c.availability=='available']}
+    scope=path_scope(proof.value,context);root=domain(proof.value['final_url'])
+    targets=nominations(proof,pages,http.robots)
+    known={c.field for c in section.claims};count=sum(c.field.startswith('dated_item.') for c in section.claims)
+    checked=set(envelope.run.refresh.get('activity',{}).get('checked_urls',[]))
+    calls=0;started=http.counts.get(org,0)
+    ceiling_token=extra_request_ceiling.set((org,started+2))
+    http.activity_extra.add(org)
+    try:
+        while targets and calls<2 and http.counts.get(org,0)-started<2 and count<10:
+            target=targets.pop(0);calls+=1
+            response=await http.get(target,org,root,xml=True)
+            checked.add(response.url)
+            if response.status!=200 or domain(response.url)!=root:continue
+            try:items,children=await offload(entries,response.body,response.url,datetime.now(timezone.utc))
+            except (ValueError,ET.ParseError):continue
+            if children:
+                targets=children[:1]+targets
+                continue
+            for value,locator,span in items:
+                field='dated_item.'+digest(value['url'])[:20]
+                if field in known or count>=10:continue
+                if scope and (not urlsplit(value['url']).path.startswith(scope+'/') or not mentions_company(value['title'],company_names(context))):continue
+                title_response=None;title_span=None
+                if value.get('title_source')=='title from URL':
+                    if calls>=2 or http.counts.get(org,0)-started>=2:break
+                    calls+=1;title_response=await http.get(value['url'],org,root)
+                    checked.add(title_response.url)
+                    if title_response.status!=200 or domain(title_response.url)!=root:continue
+                    page=await offload(Page,title_response.body,title_response.url)
+                    if not page.title or len(page.title)>200 or not page.span_for(page.title):continue
+                    if re.search(r'add.to.cart|legg.{0,10}handlekurv',page.raw,re.I):continue
+                    value={**value,'title':page.title,'title_source':'page_title'}
+                    title_span=page.span_for(page.title)[:300]
+                value={**value,'identity_level':proof.value['identity_level'],'identity_claim_id':proof.id}
+                add(section,response_source(response),org,'activity',field,value,locator,span=span,effective=value['date'],
+                    source_class='company_owned',method='signalpost.activity.index.v1')
+                if title_response is not None:
+                    extra=Section();add(extra,response_source(title_response),org,'activity',field,value,'/title',span=title_span,
+                        source_class='company_owned',method='signalpost.activity.index-title.v1')
+                    section.claims[-1].evidence_ids+=extra.claims[0].evidence_ids;section.evidence+=extra.evidence
+                known.add(field);count+=1
+    except SourceFailure:
+        pass  # Supplementary discovery never hides existing verified articles or registry activity.
+    finally:
+        extra_request_ceiling.reset(ceiling_token)
+        http.activity_extra.discard(org)
+        envelope.run.refresh.setdefault('activity',{})['checked_urls']=sorted(checked)
+    if section.claims:section.state='available'
+    return section
