@@ -0,0 +1,89 @@
+import asyncio
+import hashlib
+from datetime import datetime,timezone
+from types import SimpleNamespace
+import pytest
+from signalpost.web.index_news import entries,supplement
+from signalpost.web.html import Page
+from signalpost.sources.extract import Section
+from signalpost.budget import SourceFailure
+
+NOW=datetime(2026,11,12,tzinfo=timezone.utc)
+
+def xml(url='https://example.no/news/contract',date='2026-11-01',title='New workshop'):
+    return f'<rss><channel><item><title>{title}</title><link>{url}</link><pubDate>{date}</pubDate></item></channel></rss>'.encode()
+
+@pytest.mark.parametrize('url,date,expected',[
+    ('https://example.no/news/contract','2026-11-01',1),
+    ('https://foreign.no/news/contract','2026-11-01',0),
+    ('https://example.no/news/contract','',0),
+    ('https://example.no/news/contract','2024-11-11',0),
+    ('https://example.no/news/contract','2024-11-12',1),
+    ('https://example.no/shop/product','2026-11-01',0)])
+def test_feed_item_eligibility(url,date,expected):
+    assert len(entries(xml(url,date),'https://example.no/feed/',NOW)[0])==expected
+
+
+def test_sitemap_requires_explicit_date():
+    assert not entries(b'<urlset><url><loc>https://example.no/news/workshop</loc></url></urlset>','https://example.no/sitemap.xml',NOW)[0]
+
+
+def test_supplement_keeps_budget_domain_limit_and_source_span():
+    body=xml(date=datetime.now(timezone.utc).date().isoformat())
+    response=SimpleNamespace(url='https://example.no/feed/',body=body,status=200,
+        sha=hashlib.sha256(body).hexdigest(),retrieved_at='2026-11-12T00:00:00Z')
+    calls=[]
+    async def get(url,*args,**kwargs):
+        calls.append(url)
+        if len(calls)>1:raise SourceFailure('website_budget_exhausted')
+        return response
+    proof=SimpleNamespace(field='official_website',availability='available',carried_forward=False,id='proof',
+        value={'identity_level':'VERIFIED','final_url':'https://example.no'})
+    envelope=SimpleNamespace(claims=[proof],run=SimpleNamespace(refresh={}))
+    http=SimpleNamespace(get=get,robots={},counts={},activity_extra=set())
+    page=Page(b'<link rel="alternate" type="application/rss+xml" href="/feed/">','https://example.no')
+    section=asyncio.run(supplement(Section(state='not_available'),'123',envelope,http,[(SimpleNamespace(url=page.url),page)]))
+    assert len(calls)<=2 and calls[0]=='https://example.no/feed/'
+    assert len(section.claims)==1 and section.state=='available'
+    assert section.claims[0].value['date_source']=='pubDate'
+    assert section.evidence[0].claim_span in body.decode()
+    assert not http.activity_extra
+
+
+def test_nonverified_site_never_fetches():
+    proof=SimpleNamespace(field='official_website',availability='available',carried_forward=False,
+        value={'identity_level':'LOW'})
+    envelope=SimpleNamespace(claims=[proof])
+    section=Section(state='not_available')
+    assert asyncio.run(supplement(section,'123',envelope,None,[])) is section
+
+
+def test_actual_http_ceiling_counts_robots_and_stops_third_request(tmp_path):
+    import httpx
+    from signalpost.web.fetcher import WebsiteHttp, extra_request_ceiling
+    from signalpost.budget import Budget
+    from signalpost.sources.blobstore import BlobStore
+    from tests.test_registry import config
+    from tests.test_websites import OUR
+    calls=[]
+    def respond(request):
+        calls.append(str(request.url))
+        return httpx.Response(200,text='User-agent: *\nAllow: /' if request.url.path=='/robots.txt' else 'ok')
+    async def dns(*args):return ['93.184.216.34']
+    cfg=config(tmp_path,[OUR]).model_copy(update={'website_politeness_seconds':0})
+    async def run():
+        async with httpx.AsyncClient(transport=httpx.MockTransport(respond)) as client:
+            http=WebsiteHttp(client,cfg,Budget(cfg),BlobStore(cfg.state_dir),dns)
+            token=extra_request_ceiling.set((OUR,2))
+            try:
+                await http.get('https://example.no/feed/',OUR,'example.no')
+                with pytest.raises(SourceFailure):await http.get('https://example.no/sitemap.xml',OUR,'example.no')
+            finally:extra_request_ceiling.reset(token)
+            assert http.counts[OUR]==2
+    asyncio.run(run())
+    assert len(calls)==2 and calls[0].endswith('/robots.txt')
+
+
+def test_existing_news_never_adds_supplementary_requests():
+    section=Section(claims=[SimpleNamespace(field='dated_item.existing',availability='available')])
+    assert asyncio.run(supplement(section,'123',None,None,[])) is section
